# Spotify (get credentials at developer.spotify.com)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI="http://127.0.0.1:8000/callback/spotify"

# Yeelight / Xiaomi lights (NO token needed — enable LAN Control in Yeelight app)
XIAOMI_LIGHT_IP=192.168.1.136
XIAOMI_LIGHT_2_IP=

# Server
HOST=0.0.0.0
PORT=8000
